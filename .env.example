# Copy to .env before starting Docker Compose. Demo mode works with both keys blank.
DEMO_MODE=true
DATABASE_URL=postgresql+asyncpg://spike:spike@db:5432/spikemetrics

# Free API credentials (optional for demo):
# football-data.org: register at https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=5febc2b3680445b0b8510fa0e3c629b4
# API-Football: create a free account at https://www.api-football.com/ and copy its API key
API_FOOTBALL_KEY=7a242a74dc58fec74ae6cc1cc0993764
API_FOOTBALL_DAILY_LIMIT=100
FOOTBALL_DATA_PER_MINUTE=10
FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1,CL,PPL,DED,ELC,BSA
SYNC_INTERVAL_HOURS=6
CORS_ORIGINS=http://localhost:5173
# Set this before exposing /admin/sync on a public deployment.
ADMIN_API_TOKEN=
# Vercel Cron sends this as an Authorization Bearer token.
CRON_SECRET=
